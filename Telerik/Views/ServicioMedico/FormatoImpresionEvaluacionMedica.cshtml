@model Telerik.Models.ViewModels.EvaluacionMedicaVm
@{
    Layout = null;
    var orden = ViewBag.Orden as Telerik.Models.ViewModels.OrdenServicioMedicoVm;
    var paciente = ViewBag.Paciente as Telerik.Models.ViewModels.PacienteInfoVm;
    bool isCandidato = paciente.Tipo == "CANDIDATO";

    Func<string, string> GetAntVal = (condicion) =>
    {
        if (Model.Antecedentes == null) return "";
        // Look for exact match or contains (for legacy support if abbreviation is within the new name)
        var ant = Model.Antecedentes.FirstOrDefault(x => x.NombreCondicion != null && 
            (x.NombreCondicion.ToUpper() == condicion.ToUpper() || condicion.ToUpper().Contains(x.NombreCondicion.ToUpper())));
        return (ant != null && ant.EsPositivo) ? "X" : "";
    };

    Func<string, string> GetAntDet = (condicion) =>
    {
        if (Model.Antecedentes == null) return "";
        var ant = Model.Antecedentes.FirstOrDefault(x => x.NombreCondicion != null && 
            (x.NombreCondicion.ToUpper() == condicion.ToUpper() || condicion.ToUpper().Contains(x.NombreCondicion.ToUpper())));
        return ant?.Detalles ?? "";
    };

    Func<int?, string> GetTipoSangre = (id) =>
    {
        switch (id)
        {
            case 1: return "O+";
            case 2: return "O-";
            case 3: return "A+";
            case 4: return "A-";
            case 5: return "B+";
            case 6: return "B-";
            case 7: return "AB+";
            case 8: return "AB-";
            default: return "";
        }
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Examen Médico - @orden.FolioDisplay</title>
    <style>        @@page { size: letter; margin: 10mm; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; font-size: 7.5pt; line-height: 1.1; color: #000; background: #fff; }
        
        .page-container { 
            width: 100%; 
            max-width: 800px; 
            margin: 0 auto; 
            padding: 0; 
            min-height: 255mm; 
            display: flex; 
            flex-direction: column; 
            page-break-after: always;
        }
        .page-container:last-child { page-break-after: auto; }
        
        /* Main Header Table */
        .top-header { width: 100%; border-collapse: collapse; border: 1.5px solid #000; margin-bottom: 5px; }
        .top-header td { border: 1px solid #000; text-align: center; vertical-align: middle; }
        .logo-cell { width: 22%; padding: 4px; }
        .logo-cell img { max-height: 48px; width: auto; }
        .title-cell { width: 56%; font-weight: bold; font-size: 9pt; background: #fff; }
        .hse-cell { width: 22%; padding: 4px; }
        .hse-cell img { max-height: 48px; width: auto; }
        
        .hoja-count { text-align: right; font-weight: bold; font-size: 7.5pt; margin: 1px 15px 3px 0; }
        
        /* Form Inputs & Lines */
        .field-row { display: flex; margin-bottom: 2px; align-items: flex-end; }
        .field-label { font-weight: bold; margin-right: 4px; white-space: nowrap; }
        .field-value { border-bottom: 1px solid #000; flex-grow: 1; min-height: 12px; padding-bottom: 0px; }
        .field-value-fixed { border-bottom: 1px solid #000; display: inline-block; padding: 0 3px; min-height: 12px; }
        
        /* Antecedent Items (Compact layout) */
        .ant-item { display: flex; align-items: center; margin-bottom: 1px; height: 12px; overflow: hidden; }
        .ant-box { 
            width: 15px; 
            border-bottom: 0.5px solid #000; 
            text-align: center; 
            font-weight: bold; 
            font-size: 7pt; 
            margin-right: 3px; 
            height: 11px; 
            line-height: 11px; 
            flex-shrink: 0; 
        }
        .ant-label { font-size: 6.8pt; white-space: nowrap; flex-shrink: 0; font-weight: 500; text-transform: uppercase; }
        .ant-detail { 
            font-size: 6pt; 
            color: #444; 
            margin-left: 3px; 
            border-bottom: 0.1px solid #ddd; 
            flex-grow: 1; 
            height: 10px; 
            line-height: 10px; 
            overflow: hidden; 
            text-overflow: ellipsis; 
        }

        /* Checkboxes */
        .chk-box { display: inline-block; width: 10px; height: 10px; border: 1px solid #000; margin-right: 3px; vertical-align: middle; text-align:center; line-height:8px; font-weight:bold; font-size:8pt; }
        .chk-container { display: inline-flex; align-items: center; margin-right: 12px; }
        
        /* Section Bars */
        .section-bar { width: 100%; background: #e6e6e6; border: 1px solid #000; padding: 1px 0; text-align: center; font-weight: bold; font-size: 7pt; letter-spacing: 0.3px; -webkit-print-color-adjust: exact; print-color-adjust: exact; margin: 2px 0;}
        
        /* Grids & Tables */
        .grid-3col { display: grid; grid-template-columns: 1fr 1fr 1fr; border: 1px solid #000; border-top:none; }
        .grid-4col { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; border: 1px solid #000; border-top:none; }
        .grid-item { padding: 2px; border-right: 1px solid #000; font-size: 7pt; }
        .grid-item:last-child { border-right: none; }
        
        .col-list { display: flex; flex-direction: column; gap: 1px; }
        
        /* Tables */
        .data-table { width: 100%; border-collapse: collapse; border: 1px solid #000; }
        .data-table th, .data-table td { border: 1px solid #000; padding: 1px 3px; text-align: left; }
        .data-table th { background: #e6e6e6; text-align: center; font-weight: bold; -webkit-print-color-adjust: exact; print-color-adjust: exact;}
        
        .text-area-box { width: 100%; border: 1px solid #000; min-height: 35px; padding: 3px; margin-bottom: 2px; }
        
        .signature-area { margin-top: 20px; display: flex; justify-content: space-around; text-align: center; }
        .signature-line { border-top: 1px solid #000; width: 220px; margin: 0 auto; padding-top: 2px; }
        
        /* Footer precisely at the bottom */
        .footer-rev { 
            margin-top: auto;
            font-weight: bold; 
            font-size: 8pt; 
            text-align: left; 
            padding-bottom: 5px;
        }
        
        @@media print { 
            .no-print { display: none !important; } 
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
        .print-btn { position: fixed; top: 10px; right: 10px; padding: 8px 15px; background: #333; color: white; border: none; cursor: pointer; border-radius: 4px; z-index: 1000;}

        
        @@media print { 
            .no-print { display: none !important; } 
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
        .print-btn { position: fixed; top: 10px; right: 10px; padding: 8px 15px; background: #333; color: white; border: none; cursor: pointer; border-radius: 4px; z-index: 1000;}
    </style>
</head>
<body>
    <!-- Pantalla de Carga -->
    <div id="loadingOverlay" style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,1); z-index:9999; display:flex; flex-direction:column; align-items:center; justify-content:center;">
        <div class="spinner" style="width:60px; height:60px; border:6px solid #f3f3f3; border-top:6px solid #1a5276; border-radius:50%; animation:spin 1s linear infinite;"></div>
        <p style="margin-top:20px; font-family:Arial, sans-serif; font-size:14pt; font-weight:bold; color:#1a5276; letter-spacing:1px;">GENERANDO FORMATO...</p>
        <p style="margin-top:5px; font-family:Arial, sans-serif; font-size:9pt; color:#666;">Por favor espere un momento</p>
    </div>

    <style>
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        @@media print { #loadingOverlay { display: none !important; } }
    </style>

    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('loadingOverlay').style.display = 'none';
            }, 800); // Pequeño delay para asegurar renderizado suave
        });
    </script>

    <!-- PAGE 1 -->
    <div class="page-container">
        <!-- HEADER ROW -->
        <table class="top-header" style="margin-bottom: 5px;">
            <tr>
                <td class="logo-cell" rowspan="2">
                    <img src="@Url.Content("~/Content/Images/Logo_GCI.png")" alt="GCI" style="max-height: 48px;" />
                </td>
                <td class="title-cell" style="font-size:9pt;">SEGURIDAD, SALUD Y MEDIO AMBIENTE</td>
                <td class="hse-cell" rowspan="2">
                    <img src="@Url.Content("~/Content/Images/Logo_HSE.png")" alt="HSE" style="max-height: 48px;" />
                </td>   
            </tr>
            <tr>
                <td class="title-cell" style="padding: 2px;">
                    EXAMEN MÉDICO<br/>
                    <span style="font-size: 8pt; font-weight: normal;">GRUPO CONSTRUCTOR INDUSTRIAL OÍL & GAS S.A. DE C.V.</span>
                </td>
            </tr>
        </table>
        
        <div class="hoja-count">HOJA: &nbsp;&nbsp;&nbsp;&nbsp;1&nbsp;&nbsp;&nbsp;&nbsp; DE &nbsp;&nbsp;&nbsp;&nbsp;2</div>

        <!-- Datos demograficos del Empleado -->
        <div class="field-row">
            <span class="field-label">Lugar y fecha del Examen:</span>
            <span class="field-value">@(string.IsNullOrEmpty(Model.LugarEvaluacion) ? "Tula de Allende" : Model.LugarEvaluacion), @DateTime.Now.ToString("dd/MM/yyyy")</span>
            <span class="field-label" style="margin-left: 10px;">Cargo:</span>
            <span class="field-value" style="width: 150px; flex-grow:0;">@paciente.Puesto</span>
        </div>
        
        <div class="field-row">
            <span class="field-label">Nombre:</span>
            <span class="field-value">@paciente.NombreCompleto</span>
            <span class="field-label" style="margin-left: 10px;">No. IMSS:</span>
            <span class="field-value" style="width: 150px; flex-grow:0;">@Model.Nss</span>
        </div>
        
        <div class="field-row">
            <span class="field-label">Fecha de Nacimiento:</span>
            <span class="field-value" style="flex-grow:0; width: 120px;">@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "")</span>
            <span class="field-label" style="margin-left: 10px;">Edad:</span>
            <span class="field-value" style="flex-grow:0; width: 50px; text-align:center;">@paciente.Edad</span>
            <span class="field-label" style="margin-left:5px;">años</span>
            <span class="field-label" style="margin-left: 15px;">Estado de nac.:</span>
            <span class="field-value">@Model.LugarNacimiento</span>
        </div>
        
        <!-- RFC/CURP Omitidos -->
        
        <div class="field-row" style="margin-top: 5px;">
            <span class="field-label">Estado Civil:</span>
            <span class="chk-container"><span class="chk-box">@(Model.EstadoCivil == "1" || Model.EstadoCivil?.ToUpper() == "SOLTERO" ? "X" : "")</span> soltero</span>
            <span class="chk-container"><span class="chk-box">@(Model.EstadoCivil == "2" || Model.EstadoCivil?.ToUpper() == "CASADO" ? "X" : "")</span> casado</span>
            <span class="chk-container"><span class="chk-box">@(Model.EstadoCivil == "3" || Model.EstadoCivil?.ToUpper() == "UNIÓN LIBRE" || Model.EstadoCivil?.ToUpper() == "UNION LIBRE" ? "X" : "")</span> union libre</span>
            <span class="chk-container"><span class="chk-box">@(Model.EstadoCivil == "4" || Model.EstadoCivil?.ToUpper() == "DIVORCIADO" || Model.EstadoCivil?.ToUpper() == "VIUDO" || Model.EstadoCivil?.ToUpper() == "SEPARADO / OTRO" ? "X" : "")</span> separado/otro</span>
            
            <span class="field-label" style="margin-left: 10px;">Mano dominante:</span>
            <span class="field-value" style="flex-grow:0; width: 120px; text-align:center;">@Model.ManoDominante</span>
            
            <span class="field-label" style="margin-left: 10px;">Teléfono:</span>
            <span class="field-value">@Model.Telefono</span>
        </div>
        
        <div class="field-row">
            <span class="field-label">Domicilio Personal:</span>
            <span class="field-value">
                @{
                    string dirFull = Model.Domicilio;
                    if (string.IsNullOrEmpty(dirFull)) {
                        var parts = new List<string>();
                        if (!string.IsNullOrEmpty(Model.Calle)) { parts.Add(Model.Calle); }
                        if (!string.IsNullOrEmpty(Model.NumExterior)) { parts.Add("#" + Model.NumExterior); }
                        if (!string.IsNullOrEmpty(Model.NumInterior)) { parts.Add("Int. " + Model.NumInterior); }
                        if (parts.Count > 0) { dirFull = string.Join(" ", parts); }
                    }
                }
                @dirFull
            </span>
        </div>
        
        <div class="field-row" style="margin-top:5px;">
            <span class="field-label">Nivel Académico:</span>
            <span class="chk-container"><span class="chk-box">@(Model.Escolaridad?.ToUpper() == "PRIMARIA" ? "X" : "")</span> Primaria</span>
            <span class="chk-container"><span class="chk-box">@(Model.Escolaridad?.ToUpper() == "SECUNDARIA" ? "X" : "")</span> Secundaria</span>
            <span class="chk-container"><span class="chk-box">@(Model.Escolaridad?.ToUpper() == "PREPARATORIA" || Model.Escolaridad?.ToUpper() == "MEDIA SUPERIOR" || Model.Escolaridad?.ToUpper() == "BACHILLERATO" ? "X" : "")</span> Media Sup.</span>
            <span class="chk-container"><span class="chk-box">@(Model.Escolaridad?.ToUpper() == "UNIVERSIDAD" || Model.Escolaridad?.ToUpper() == "PROFESIONAL" || Model.Escolaridad?.ToUpper() == "LICENCIATURA" || Model.Escolaridad?.ToUpper() == "POSGRADO" ? "X" : "")</span> Universidad</span>
            <span class="field-label" style="margin-left: 10px;">Profesión:</span>
            <span class="field-value">@Model.Profesion</span>
        </div>
        
        <div class="field-row" style="margin-top:5px;">
            <span class="field-label">Examen de:</span>
            <span class="chk-container"><span class="chk-box">@(isCandidato ? "X" : "")</span> Ingreso</span>
            <span class="chk-container"><span class="chk-box">@(!isCandidato ? "X" : "")</span> Periódico</span>
            
            <span class="field-label" style="margin-left: 20px;">Sexo:</span>
            <span class="chk-container"><span class="chk-box">@(paciente.Sexo == "M" ? "X" : "")</span> Masc</span>
            <span class="chk-container"><span class="chk-box">@(paciente.Sexo == "F" ? "X" : "")</span> Fem</span>
            
            <span class="field-label" style="margin-left: 20px;">Tipo de Sangre:</span>
            <span class="field-value" style="width: 100px; flex-grow:0; text-align:center;">@GetTipoSangre(Model.FkTipoSangre)</span>
        </div>

        <!-- Antecentdes Herederos Familiarias -->
        <div class="section-bar">ANTECEDENTE HEREDO FAMILIARES</div>
        <div class="grid-4col" style="border-top:1px solid #000;">
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("HIPERTENSIÓN (HTA)")</span> <span class="ant-label">HIPERTENSI&Oacute;N (HTA)</span> <span class="ant-detail">@GetAntDet("HIPERTENSIÓN (HTA)")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ENFERMEDAD CORONARIA")</span> <span class="ant-label">ENFERMEDAD CORONARIA</span> <span class="ant-detail">@GetAntDet("ENFERMEDAD CORONARIA")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ACCIDENTE CEREBROVAS. (ACV)")</span> <span class="ant-label">ACCIDENTE CEREBROVAS. (ACV)</span> <span class="ant-detail">@GetAntDet("ACCIDENTE CEREBROVAS. (ACV)")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("DIABETES MELLITUS")</span> <span class="ant-label">DIABETES MELLITUS</span> <span class="ant-detail">@GetAntDet("DIABETES MELLITUS")</span></div>
            </div>
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("TIROIDES / ENDÓCRINO")</span> <span class="ant-label">TIROIDES / END&Oacute;CRINO</span> <span class="ant-detail">@GetAntDet("TIROIDES / ENDÓCRINO")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ASMA BRONQUIAL")</span> <span class="ant-label">ASMA BRONQUIAL</span> <span class="ant-detail">@GetAntDet("ASMA BRONQUIAL")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ALERGIAS")</span> <span class="ant-label">ALERGIAS</span> <span class="ant-detail">@GetAntDet("ALERGIAS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("TUBERCULOSIS (TBC)")</span> <span class="ant-label">TUBERCULOSIS (TBC)</span> <span class="ant-detail">@GetAntDet("TUBERCULOSIS (TBC)")</span></div>
            </div>
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("ALCOHOLISMO")</span> <span class="ant-label">ALCOHOLISMO</span> <span class="ant-detail">@GetAntDet("ALCOHOLISMO")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("EPILEPSIA / CONVUL.")</span> <span class="ant-label">EPILEPSIA / CONVUL.</span> <span class="ant-detail">@GetAntDet("EPILEPSIA / CONVUL.")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ENFERM. MENTALES")</span> <span class="ant-label">ENFERM. MENTALES</span> <span class="ant-detail">@GetAntDet("ENFERM. MENTALES")</span></div>
            </div>
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("MALFORM. CONGÉNITAS")</span> <span class="ant-label">MALFORM. CONG&Eacute;NITAS</span> <span class="ant-detail">@GetAntDet("MALFORM. CONGÉNITAS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("CÁNCER / TUMORALES")</span> <span class="ant-label">C&Aacute;NCER / TUMORALES</span> <span class="ant-detail">@GetAntDet("CÁNCER / TUMORALES")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("VÁRICES")</span> <span class="ant-label">V&Aacute;RICES</span> <span class="ant-detail">@GetAntDet("VÁRICES")</span></div>
            </div>
        </div>

        <!-- Antecedentes Patologicos -->
        <div class="section-bar">ANTECEDENTES PERSONALES Patológicos</div>
        <div class="grid-3col" style="border-top:1px solid #000; grid-template-columns: 1fr 1fr 1fr;">
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("HIPERTENSIÓN (HTA)")</span> <span class="ant-label">HIPERTENSI&Oacute;N (HTA)</span> <span class="ant-detail">@GetAntDet("HIPERTENSIÓN (HTA)")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("QUIRÚRGICOS")</span> <span class="ant-label">QUIR&Uacute;RGICOS</span> <span class="ant-detail">@GetAntDet("QUIRÚRGICOS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("TRAUMÁTICOS")</span> <span class="ant-label">TRAUM&Aacute;TICOS</span> <span class="ant-detail">@GetAntDet("TRAUMÁTICOS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ALÉRGICOS")</span> <span class="ant-label">AL&Eacute;RGICOS</span> <span class="ant-detail">@GetAntDet("ALÉRGICOS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("CONGÉNITOS")</span> <span class="ant-label">CONG&Eacute;NITOS</span> <span class="ant-detail">@GetAntDet("CONGÉNITOS")</span></div>
            </div>
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("METABÓLICOS")</span> <span class="ant-label">METAB&Oacute;LICOS</span> <span class="ant-detail">@GetAntDet("METABÓLICOS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("INFECTOCONTAGIOSOS")</span> <span class="ant-label">INFECTOCONTAGIOSOS</span> <span class="ant-detail">@GetAntDet("INFECTOCONTAGIOSOS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("TUMORALES / CÁNCER")</span> <span class="ant-label">TUMORALES / C&Aacute;NCER</span> <span class="ant-detail">@GetAntDet("TUMORALES / CÁNCER")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("ENF. RESPIRATORIAS")</span> <span class="ant-label">ENF. RESPIRATORIAS</span> <span class="ant-detail">@GetAntDet("ENF. RESPIRATORIAS")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("CONSUMO MEDICAMENTOS")</span> <span class="ant-label">CONSUMO MEDICAMENTOS</span> <span class="ant-detail">@GetAntDet("CONSUMO MEDICAMENTOS")</span></div>
            </div>
            <div class="grid-item col-list">
                <div class="ant-item"><span class="ant-box">@GetAntVal("TRANSFUSIONALES")</span> <span class="ant-label">TRANSFUSIONALES</span> <span class="ant-detail">@GetAntDet("TRANSFUSIONALES")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("LITIASIS (PIEDRAS)")</span> <span class="ant-label">LITIASIS (PIEDRAS)</span> <span class="ant-detail">@GetAntDet("LITIASIS (PIEDRAS)")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("HACINAMIENTO")</span> <span class="ant-label">HACINAMIENTO</span> <span class="ant-detail">@GetAntDet("HACINAMIENTO")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("SERVICIOS: AGUA")</span> <span class="ant-label">SERVICIOS: AGUA</span> <span class="ant-detail">@GetAntDet("SERVICIOS: AGUA")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("SERVICIOS: DRENAJE")</span> <span class="ant-label">SERVICIOS: DRENAJE</span> <span class="ant-detail">@GetAntDet("SERVICIOS: DRENAJE")</span></div>
                <div class="ant-item"><span class="ant-box">@GetAntVal("OTROS ANTECEDENTES")</span> <span class="ant-label">OTROS ANTECEDENTES:</span> <span class="ant-detail">@GetAntDet("OTROS ANTECEDENTES")</span></div>
            </div>
        </div>
        <div style="border: 1px solid #000; border-top:none; padding: 2px 4px;">

        <!-- Antecendestes Labores del Empleado -->
        <div class="section-bar">ANTECEDENTES LABORALES</div>
        <table class="data-table" style="border-top:none;">
            <thead>
                <tr>
                    <th style="width: 25%;">EMPRESA</th>
                    <th style="width: 15%;">TIEMPO</th>
                    <th style="width: 25%;">PUESTO</th>
                    <th style="width: 20%;">AGENTES EXPUESTOS</th>
                    <th style="width: 15%;">ACCIDENTES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AntecedentesLaborales != null && Model.AntecedentesLaborales.Any())
                {
