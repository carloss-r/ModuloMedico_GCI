        <table class="data-table" style="border-top:none; font-size: 7.5pt;">
            <thead>
                <tr>
                    <th style="width: 25%;">Aparato / Sistema</th>
                    <th style="width: 8%; text-align:center;">Normal</th>
                    <th style="width: 8%; text-align:center;">Anormal</th>
                    <th style="width: 59%;">Descripción de Hallazgos</th>
                </tr>
            </thead>
            <tbody>
                @{
                    string[] sistemasFijos = { 
                        "1. Cabeza", "2. Ojos", "3. Nariz", "4. Boca",
                        "5. Dentadura", "6. Faringe", "7. Amígdalas", "8. Otoscopia",
                        "9. Cuello", "10. Columna-espalda", "11. Extremidades", "12. Piel",
                        "13. Ap. Respiratorio", "14. Cardiaco", "15. Vascular periférico",
                        "16. Abdomen", "17. Neurológico", "18. Genitales", "19. Hernias", "20. Otro"
                    };

                    var renderedNames = new HashSet<string>();

                    foreach(var s in sistemasFijos)
                    {
                        var ef = Model.OrdenExamenFisico?.FirstOrDefault(x => x.SistemaCuerpo != null && x.SistemaCuerpo.Trim().ToUpper() == s.Trim().ToUpper());
                        string hallazgos = "";
                        bool? esNormal = true; // Use nullable to detect if record exists
                        
                        if (ef != null) {
                            renderedNames.Add(ef.SistemaCuerpo.Trim().ToUpper());
                            hallazgos = ef.Hallazgos ?? "";
                            esNormal = ef.EsNormal;
                        } else {
                            esNormal = null; // Mark as "not in DB" to show empty checkboxes or default Normal
                        }

                        if (hallazgos.Length > 150) { hallazgos = hallazgos.Substring(0, 147) + "..."; }

                        <tr>
                            <td style="font-size: 7.2pt; font-weight: bold; padding-left: 5px;">@s</td>
                            <td style="text-align:center;">@(esNormal == true ? "X" : "")</td>
                            <td style="text-align:center;">@(esNormal == false ? "X" : "")</td>
                            <td style="font-size: 7.2pt;">@hallazgos</td>
                        </tr>
                    }
                    
                    // Fallback para sistemas dinámicos o extras que no están en la lista fija
                    if (Model.OrdenExamenFisico != null) {
                        foreach(var ef in Model.OrdenExamenFisico.Where(x => x.SistemaCuerpo != "AGUDEZA_VISUAL" && !renderedNames.Contains(x.SistemaCuerpo.Trim().ToUpper()))) {
                             <tr>
                                <td style="font-size: 7.2pt; font-weight: bold; padding-left: 5px;">@ef.SistemaCuerpo</td>
                                <td style="text-align:center;">@(ef.EsNormal ? "X" : "")</td>
                                <td style="text-align:center;">@(!ef.EsNormal ? "X" : "")</td>
                                <td style="font-size: 7.2pt;">@ef.Hallazgos</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
        <div class="footer-rev">GCI-FOR-SYM-45 REV. 0</div>
    </div>

